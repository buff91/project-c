{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/Tools/Hooks/check-cs-edit.sh\"",
            "timeout": 15,
            "statusMessage": "C# 규칙 확인"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/Tools/Hooks/verify-core-tests.sh\"",
            "timeout": 180,
            "statusMessage": "Core 규칙 테스트 확인"
          }
        ]
      }
    ]
  }
}
