# 이 파일을 Tools/ArtPipeline/.art-review/env로 복사하고 실제 값을 넣는다.
# 실제 토큰 파일은 .gitignore 대상이다.
SLACK_APP_TOKEN=xapp-your-socket-mode-token
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_ART_CHANNEL_ID=C0123456789

# 필수. 비워 두거나 빠뜨리면 봇이 시작하지 않고, 목록에 없는 사용자의
# 승인·준비·게시·생성 요청은 전부 거부된다(fail-closed).
SLACK_ART_ALLOWED_USERS=U0123456789

COMFYUI_URL=http://127.0.0.1:8188

# Steam판 자동 탐지가 실패할 때만 사용한다.
# PROJECTC_ASEPRITE_BIN=/absolute/path/to/aseprite
