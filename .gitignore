# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data (only ignore when the asset itself is ignored)
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VSCode generated
.vs/
.idea/
/*.csproj
/*.sln
/*.slnx
/*.unityproj
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.suo
ExportedObj/
.consulo/
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlog.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Android signing / build (절대 커밋 금지 — 서명 키)
*.keystore
*.keystore.meta
*.jks
.gradle/

# iOS signing / provisioning
*.pfx
*.mobileprovision
*.p12

# Addressables / StreamingAssets 대용량 바이너리
/[Aa]ssets/[Ss]treamingAssets/
/[Aa]ssets/AddressableAssetsData/*/*.bin

# Claude Code 로컬 개인 설정
.claude/settings.local.json

# OS
.DS_Store

# Python bytecode (art pipeline tooling)
__pycache__/
*.pyc

# ComfyUI REST로 받은 검토용 생성물. 채택한 소스 시트만 정식 이름으로 이동한다.
/docs/art-direction/comfyui/output/

# dotnet 테스트 shim 산출물 (Tools/CoreTests — Unity 없이 Core 테스트)
/Tools/CoreTests/bin/
/Tools/CoreTests/obj/

# MCP 검증 캡처 (manage_ui render_ui 의 기본 출력 경로).
# 화면 확인용 산출물이라 리포에 남기지 않는다 — 필요하면 그때 다시 찍는다.
/Assets/Screenshots/
/Assets/Screenshots.meta
