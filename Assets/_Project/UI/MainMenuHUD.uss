.main-menu-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--pc-void);
    background-image: url("../Art/Runtime/ui-main-menu-backdrop.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* 이름이 vignette 였던 시절엔 이게 비네트가 아니라 카드라는 사실이 가려졌고,
   Phase 5 의 진짜 화면공간 비네트와 이름이 충돌했다. */
.main-menu-card {
    width: 400px;
    max-width: 88%;
    align-items: center;
    padding: 16px 24px 12px 24px;
    background-color: rgba(10, 13, 19, 0.78);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--pc-stone);
    border-top-color: var(--pc-stone);
    border-right-color: var(--pc-stone-dim);
    border-bottom-color: var(--pc-stone-dim);
}

.main-menu-title {
    color: var(--pc-gold);
    font-size: var(--pc-fs-4);
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.main-menu-subtitle {
    margin-top: 4px;
    color: var(--pc-stone-lit);
    font-size: var(--pc-fs-2);
    -unity-text-align: middle-center;
}

.main-menu-divider {
    align-self: stretch;
    height: 1px;
    margin-top: 28px;
    margin-bottom: 24px;
    background-color: var(--pc-gold-deep);
}

.main-story-slot {
    align-items: center;
}

.main-story-kicker {
    color: var(--pc-text);
    font-size: var(--pc-fs-2);
    -unity-text-align: middle-center;
}

.main-story-copy {
    margin-top: 8px;
    color: var(--pc-dim);
    font-size: var(--pc-fs-1);
    white-space: normal;
    -unity-text-align: middle-center;
}

.main-menu-actions {
    width: 200px;
    max-width: 100%;
    margin-top: 12px;
    align-items: center;
}

.main-primary-button,
.main-secondary-button {
    width: 176px;
    height: 32px;
    margin-top: 4px;
    font-size: var(--pc-fs-1);
}

.main-menu-utility {
    flex-direction: row;
    margin-top: 8px;
}

.main-utility-button {
    height: 38px;
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 16px;
    padding-right: 16px;
    color: var(--pc-dim);
    background-color: transparent;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--pc-stone-dim);
    border-right-color: var(--pc-stone-dim);
    border-top-color: var(--pc-stone-dim);
    border-bottom-color: var(--pc-stone-dim);
}

.main-utility-button:hover {
    color: var(--pc-text);
    border-left-color: var(--pc-stone);
    border-right-color: var(--pc-stone);
    border-top-color: var(--pc-stone);
    border-bottom-color: var(--pc-stone);
}

.main-menu-root.is-narrow .main-menu-card {
    max-width: 92%;
    padding: 28px 18px 24px 18px;
}

.main-menu-root.is-narrow .main-menu-title {
    font-size: var(--pc-fs-4);
    letter-spacing: 5px;
}

.main-menu-root.is-narrow .main-menu-subtitle {
    font-size: var(--pc-fs-1);
}

.main-menu-root.is-narrow .main-menu-actions {
    width: 100%;
}

.main-menu-root.is-narrow .main-primary-button,
.main-menu-root.is-narrow .main-secondary-button {
    width: 100%;
}

.main-menu-root.is-short .main-menu-card {
    padding-top: 20px;
    padding-bottom: 18px;
}

.main-menu-root.is-short .main-menu-divider {
    margin-top: 16px;
    margin-bottom: 14px;
}

.main-menu-root.is-short .main-menu-actions {
    margin-top: 16px;
}

/* ⚠ 640×360 에서는 PC 가 **항상** is-short + is-landscape 다. 예전의 2열 배치는
   720px 폭에 270px 버튼 둘을 넣는 구성이라 640 캔버스에서 즉시 넘쳤다.
   단일 컬럼을 유지하고 세로로 빠듯한 만큼 타이틀만 한 단 줄인다. */
.main-menu-root.is-short.is-landscape .main-menu-card {
    width: 400px;
    max-width: 92%;
    padding: 12px 24px 10px 24px;
}

.main-menu-root.is-short.is-landscape .main-menu-title {
    font-size: var(--pc-fs-3);
    letter-spacing: 3px;
}

.main-menu-root.is-short.is-landscape .main-menu-subtitle {
    margin-top: 4px;
    font-size: var(--pc-fs-1);
}

.main-menu-root.is-short.is-landscape .main-menu-divider {
    margin-top: 8px;
    margin-bottom: 8px;
}

.main-menu-root.is-short.is-landscape .main-story-copy {
    display: none;
}

.main-menu-root.is-short.is-landscape .main-story-kicker {
    font-size: var(--pc-fs-1);
}

.main-menu-root.is-short.is-landscape .main-menu-actions {
    width: 200px;
    max-width: 100%;
    margin-top: 8px;
    flex-direction: column;
}

.main-menu-root.is-short.is-landscape .main-primary-button,
.main-menu-root.is-short.is-landscape .main-secondary-button {
    width: 176px;
    flex-grow: 0;
    margin: 2px;
}

.main-menu-root.is-short.is-landscape .main-menu-utility {
    margin-top: 6px;
}

.main-utility-button.icon-label-button .ui-icon {
    width: 12px;
    height: 12px;
    min-width: 12px;
    min-height: 12px;
}
