/* ============================================================
   Project-C UI 디자인 시스템 "Torchstone" v1.8 — USS 토큰 + 공통 컴포넌트
   SSOT: docs/UI_DESIGN_SYSTEM.md (근거·사용 규칙은 문서 참조)
   근거: 아트 컨셉(project-c-artstyle-concept-v1.png) 픽셀 실측
         + postapoc 레퍼런스(project-c-postapoc-ref-01~05, integrated-...-target-v2) 도출
         + v0.3.3 사이버펑크 레퍼런스(reference/ref-cyberpunk-01~05).
   공식(테마 무관 유지): 차가운 청흑 바탕 + 국소 광원 + 신호색 1개(틸).
     판타지("횃불에 데워진 돌 프레임 + 토치 골드")→포스트아포("비상등에 데워진 콘크리트
     + 앰버 신호등")는 재료 어휘만 바뀌고 토큰 값·구조는 그대로다. 코어 토큰은 리네임 금지
     (런타임 카탈로그/테스트가 값을 단언). 신규는 재료색·광원색으로 추가만 한다.
   v1.7(v0.3.3 사이버펑크): **국소 광원이 웜 하나에서 웜 + 쿨 네온 둘로 늘었다.**
     늘어난 것은 광원축이지 신호축이 아니다 — 고채도 UI 신호는 여전히 --pc-teal 하나다.
     쿨 네온(--pc-neon-*)은 앰비언트 전용이고 상태·선택·판정에 쓰지 않는다(GDD §6).

   사용법: UXML에서 화면별 USS보다 먼저 로드한다.
     <ui:Style src="DesignSystem.uss" />
     <ui:Style src="화면별.uss" />
   규칙:
   - 화면별 USS는 색·크기 리터럴 대신 var(--pc-*) 토큰을 쓴다.
   - 폰트 크기는 9의 배수만 (9/18/27/36/54). 합성 볼드·소수점 자간 금지.
     (UssTypographyTests가 이 셋을 강제한다)
   - 논리 캔버스는 **640×360**이다(PanelSettings=ConstantPixelSize + UiPanelScale이 정수 배율).
     여기 컴포넌트 기본 크기도 **640×360 기준이다**(2026-07-29 이전 완료). 옛 960×540 값이
     남아 있던 시절엔 화면별 USS가 전부 덮어써서 가려졌고, 오버라이드를 빠뜨린 곳
     (허브 `.ui-icon`)에서만 24px 아이콘으로 새어 나왔다 — 기본값이 맞아야 그 사고가 없다.
     공유 기본값(.pc-heart 12×11, .ui-icon 12)은 **라이브 화면이 실제로 쓰는 값**에 맞췄다.
   한 줄 정정(실측): 정수 배율은 픽셀 폰트를 선명하게 만들지 않는다. UI Toolkit이
   글자마다 제 서브픽셀 위상에서 따로 래스터화하기 때문이다. 640×360으로 가는 이유는
   선명도가 아니라 같은 논리 px가 화면에서 커지기 때문이다(2560×1440에서 +29%).
   한계(스프라이트 승격 예정): USS엔 box-shadow가 없어 깎인 모서리·골드
   글로우는 9-slice/스프라이트로 구현한다. 그때까지는 단순 보더.
   ============================================================ */

:root {
    /* --- 폰트: Galmuri9 (한국어 픽셀 폰트, OFL) --- */
    -unity-font-definition: url("Fonts/Galmuri9.ttf");
    -unity-font: url("Fonts/Galmuri9.ttf");
    color: var(--pc-text);

    /* --- 색: 바탕 (차가운 청흑 — 씬의 어둠) --- */
    --pc-void: rgb(5, 7, 12);
    --pc-panel: rgba(10, 13, 19, 0.92);
    --pc-panel-solid: rgb(13, 16, 22);
    --pc-inset: rgb(7, 9, 14);

    /* --- 색: 프레임 계조 (v1.8 — 쿨 스틸) ---
       v1.7까지는 "횃불빛 받은 돌"(웜 토프/브라운)이었다. 판타지 시절 값이고, 테마가
       판타지 → 포스트아포 → 사이버펑크로 두 번 바뀌는 동안 재료 어휘만 재서술하고
       계조는 그대로 뒀다 — 그래서 청흑 바탕 + 네온 위에 양피지색 프레임이 얹혀
       색온도가 정면으로 부딪쳤다. 값은 전부 .gpl 의 grey 램프에서 가져왔다. */
    --pc-stone: rgb(84, 91, 97);         /* = .gpl grey-3 */
    --pc-stone-lit: rgb(223, 231, 242);  /* = .gpl ui-text-cool */
    --pc-stone-dim: rgb(44, 49, 56);     /* = .gpl grey-1 */

    /* --- 색: 골드/횃불 --- */
    --pc-gold: rgb(255, 213, 84);        /* 현재 층·선택 (실측 #FFEA5C 유래) */
    --pc-torch: rgb(255, 189, 65);       /* 횃불·화상 (실측) */
    --pc-gold-deep: rgb(154, 107, 34);

    /* --- 색: 텍스트 (v1.8 — 쿨) ---
       어두운 화면일수록 본문은 밝고 채도가 낮아야 읽힌다. 중간톤 쿨 그레이는
       청흑 판 위에서 탁하게 가라앉는다(실측). --pc-text 만 .gpl 신규 색이다. */
    --pc-text: rgb(223, 231, 242);       /* = .gpl ui-text-cool (NEW) */
    --pc-dim: rgb(148, 155, 161);        /* = .gpl grey-5 */

    /* --- 색: 시맨틱 --- */
    --pc-hp: rgb(216, 69, 42);           /* 하트 (실측) */
    --pc-hp-empty: rgb(69, 16, 11);
    --pc-teal: rgb(79, 167, 160);        /* 물·시스템 (실측 #1C4347 유래) */
    --pc-ice: rgb(154, 223, 232);
    --pc-teal-bg: rgb(20, 52, 58);
    --pc-teal-bg-hover: rgb(27, 68, 75);
    --pc-xp: rgb(127, 178, 65);          /* 경험치·중독 */

    /* --- 색: POSTAPOC 재료 (refs 01~05·target-v2 도출. .gpl 인덱스 18~와 1:1) ---
       코어 원리(청흑 void+국소 앰버+틸 신호)는 유지. 폐허 재료 어휘만 확장.
       stone(웜·조명면)과 달리 concrete는 냉·비조명 그림자면이다. */
    --pc-concrete: rgb(107, 113, 120);
    --pc-concrete-dim: rgb(59, 63, 69);
    --pc-rust: rgb(156, 90, 46);         /* 녹 — 드럼통·철골·간판·방폭문 */
    --pc-rust-dark: rgb(90, 46, 27);
    --pc-moss: rgb(110, 138, 60);        /* 이끼·담쟁이(자연 잠식) — xp 그린보다 올리브 */
    --pc-moss-dim: rgb(62, 74, 36);
    --pc-hazard: rgb(224, 166, 43);      /* 흑황 위험 스트라이프의 황 (diegetic) */
    --pc-warning: rgb(240, 73, 42);      /* 붉은 신호/봉인 네온 — HP와 역할 분리 */

    /* --- 색: 쿨 네온 (v1.8 — 세 갈래로 갈랐다) ---
       v1.7은 "네온은 전부 장식 광원, 고채도 UI 신호는 틸 하나"였다. 그 조항이
       **이 장르의 서명인 UI 크롬의 네온을 막아** 화면을 중성 회색으로 끌어내렸다.
       색상환에서 축을 갈라 해결한다 — 세 용도가 서로 겹치지 않는다:
         · --pc-neon-cyan    = 월드 **장식 광원** 전용 (간판·홀로·자판기). UI 사용 금지.
         · --pc-ui-accent    = **UI 크롬** 전용 (프레임·브래킷·기술 라벨). 월드 사용 금지.
         · --pc-teal         = **판정 신호** 전용 (Hole·해금된 출구·게이트·빙결).
       마젠타를 UI가 가져가는 근거: 게임 규칙에 아무 의미도 없고, 반대로 이미
       플레이어 정체색이라 "내 장비가 그리는 화면"이 공짜로 설명된다. 판독 충돌 0.
       -dead-* 는 꺼진 상태다 — 이 세계의 네온은 대부분 죽어 있고, 켜진 색은 희소해야
       "살아 있는 기술 = 자원"이라는 설정이 화면에서도 성립한다.
       꺼진 색을 **새 hex가 아니라 같은 색의 알파 변형**으로 둔 이유: UI 토큰은
       스프라이트 마스터 .gpl 의 부분집합이어야 하는데(문서 「UI 토큰 ⊂ .gpl」),
       어두운 저채도 시안/마젠타를 .gpl 에 새로 더하면 기존 암부 램프와 명도 구간이 겹쳐
       양자화가 둘 사이를 오가며 스프라이트에 얼룩이 생긴다(.gpl 헤더 설계 규칙).
       알파 변형은 베이스가 sig-neon-* 그대로라 그 제약을 건드리지 않는다. */
    --pc-neon-cyan: rgb(61, 225, 232);
    --pc-neon-magenta: rgb(230, 68, 184);
    --pc-neon-dead-cyan: rgba(61, 225, 232, 0.22);
    --pc-neon-dead-magenta: rgba(230, 68, 184, 0.18);

    /* UI 크롬 액센트 (v1.8) — 값은 neon-magenta 와 같지만 **이름이 계약이다**.
       화면 USS 는 --pc-ui-accent 를 쓴다. 월드 쪽이 --pc-neon-magenta 를 쓰고,
       둘이 갈라지는 날이 와도 참조처를 안 뒤져도 되게 지금부터 이름을 나눠 둔다. */
    --pc-ui-accent: rgb(230, 68, 184);
    --pc-ui-accent-dim: rgba(230, 68, 184, 0.30);

    /* --- 색: 버튼 바탕 --- */
    --pc-btn-bg: rgb(22, 27, 35);
    --pc-btn-bg-hover: rgb(34, 42, 53);
    --pc-action-bg: rgb(31, 23, 16);
    --pc-action-bg-hover: rgb(46, 33, 21);

    /* --- 간격 (4px 그리드) --- */
    --pc-space-1: 4px;
    --pc-space-2: 8px;
    --pc-space-3: 12px;
    --pc-space-4: 16px;
    --pc-space-6: 24px;

    /* --- 타이포 스케일 (Galmuri9 9의 배수) ---
       9px 페이스이므로 크기는 9의 배수만 쓴다. 스케일에 없는 중간값(10·11·13px 같은)은
       위계를 만들지 못하면서 종류만 늘린다 — 본문은 9, 강조는 18 두 단만 쓴다.
       합성 볼드는 금지다: Galmuri9은 Regular 단일 페이스라 Unity가 래스터를 굵게 합성하며
       획이 번지고 자간이 틀어진다. 강조는 굵기가 아니라 색(--pc-gold/--pc-dim)이나 크기로. */
    --pc-fs-1: 9px;      /* 본문·캡션·레이블·버튼 */
    --pc-fs-2: 18px;     /* 주요 수치·패널 타이틀 */
    --pc-fs-3: 27px;     /* 데미지·큰 타이틀 */
    --pc-fs-4: 36px;     /* 메인 메뉴 타이틀 */
    --pc-fs-6: 54px;     /* 층 전환 연출·로고 */
}

/* ============================================================
   창 크롬 — 메뉴·인벤토리·팝업 전용. 인게임 상시 HUD엔 금지.
   (깎인 모서리는 9-slice 스프라이트 승격 예정)
   ============================================================ */

.pc-window {
    background-color: var(--pc-panel);
    padding: var(--pc-space-2);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--pc-stone);
    border-top-color: var(--pc-stone);
    border-right-color: var(--pc-stone-dim);
    border-bottom-color: var(--pc-stone-dim);
}

/* 시스템 안내(수직 경로 등) 변형 — 틸 프레임 */
.pc-window--teal {
    border-left-color: var(--pc-teal);
    border-top-color: var(--pc-teal);
    border-right-color: var(--pc-teal-bg);
    border-bottom-color: var(--pc-teal-bg);
}

.pc-window-title {
    color: var(--pc-gold);
    font-size: var(--pc-fs-1);
    -unity-text-align: middle-center;
    margin-bottom: var(--pc-space-1);
}

/* ============================================================
   플로팅 HUD — 프레임 없음. 씬 위에서 하드 섀도로만 분리.
   ============================================================ */

.pc-float-text {
    color: var(--pc-text);
    font-size: var(--pc-fs-1);
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

.pc-float-text--hint {
    color: var(--pc-ice);
}

/* 다이아 층 레일: 현재 층 = 골드 (글로우는 스프라이트 승격 시) */
.pc-dia {
    width: 24px;
    height: 24px;
    rotate: 45deg;
    background-color: rgb(21, 17, 13);
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--pc-stone-dim);
    border-top-color: var(--pc-stone-dim);
    border-right-color: var(--pc-stone-dim);
    border-bottom-color: var(--pc-stone-dim);
}

.pc-dia > * {
    rotate: -45deg;
}

.pc-dia .pc-dia-label {
    color: var(--pc-dim);
    font-size: var(--pc-fs-1);
}

.pc-dia--current {
    width: 32px;
    height: 32px;
    border-left-color: var(--pc-gold);
    border-top-color: var(--pc-gold);
    border-right-color: var(--pc-gold);
    border-bottom-color: var(--pc-gold);
}

.pc-dia--current .pc-dia-label {
    color: var(--pc-gold);
}

/* 레일 연결선 (점선은 스프라이트 승격 시) */
.pc-rail-link {
    width: 2px;
    height: 8px;
    background-color: var(--pc-stone-dim);
    align-self: center;
}

/* 다이아 액션 버튼 — 탭=선택(골드), 재탭=실행 */
.pc-dbtn {
    width: 40px;
    height: 40px;
    rotate: 45deg;
    margin: 6px;
    background-color: rgb(20, 16, 12);
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--pc-stone-lit);
    border-top-color: var(--pc-stone-lit);
    border-right-color: var(--pc-stone-dim);
    border-bottom-color: var(--pc-stone-dim);
}

.pc-dbtn > * {
    rotate: -45deg;
}

.pc-dbtn:hover {
    background-color: rgb(36, 28, 20);
}

.pc-dbtn--selected {
    border-left-color: var(--pc-gold);
    border-top-color: var(--pc-gold);
    border-right-color: var(--pc-gold);
    border-bottom-color: var(--pc-gold);
}

/* HP 하트 자리 — 실제 도트는 스프라이트(--unity-image)로 지정 */
.pc-heart {
    width: 12px;
    height: 11px;
    margin-right: 2px;
}

/* ============================================================
   버튼 (창 안 사각 버튼)
   ============================================================ */

.pc-btn {
    color: var(--pc-text);
    background-color: var(--pc-btn-bg);
    font-size: var(--pc-fs-1);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--pc-stone-dim);
    border-top-color: var(--pc-stone-dim);
    border-right-color: var(--pc-stone-dim);
    border-bottom-color: var(--pc-stone-dim);
}

.pc-btn:hover {
    background-color: var(--pc-btn-bg-hover);
}

.pc-btn:active {
    background-color: var(--pc-gold-deep);
}

/* 액션(공격/확정) — 골드 */
.pc-btn--action {
    color: var(--pc-gold);
    background-color: var(--pc-action-bg);
    border-left-color: var(--pc-gold-deep);
    border-top-color: var(--pc-gold-deep);
    border-right-color: var(--pc-gold-deep);
    border-bottom-color: var(--pc-gold-deep);
}

.pc-btn--action:hover {
    background-color: var(--pc-action-bg-hover);
}

/* 원거리/마법 — 아이스 */
.pc-btn--ranged {
    color: var(--pc-ice);
    background-color: var(--pc-teal-bg);
    border-left-color: var(--pc-teal);
    border-top-color: var(--pc-teal);
    border-right-color: var(--pc-teal);
    border-bottom-color: var(--pc-teal);
}

.pc-btn--ranged:hover {
    background-color: var(--pc-teal-bg-hover);
}

/* 시스템 토글(모드 전환 등) — 틸 텍스트 */
.pc-btn--system {
    color: var(--pc-teal);
}

/* ============================================================
   리드아웃 / 게이지 / 칩 / 슬롯
   ============================================================ */

.pc-readout {
    color: var(--pc-text);
    background-color: var(--pc-inset);
    font-size: var(--pc-fs-1);
    -unity-text-align: middle-center;
    padding-top: 3px;
    padding-bottom: 3px;
}

/* 게이지: track > fill 2겹, fill 너비는 코드에서 % 지정.
   세그먼트 눈금은 오버레이 스프라이트 승격 시. */
.pc-bar-track {
    height: 8px;
    background-color: var(--pc-hp-empty);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.pc-bar-fill {
    height: 100%;
    background-color: var(--pc-hp);
}

.pc-bar-track--xp {
    height: 4px;
    background-color: rgb(28, 36, 16);
}

.pc-bar-fill--xp {
    background-color: var(--pc-xp);
}

/* 상태이상 칩 */
.pc-chip {
    flex-direction: row;
    align-items: center;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 1px;
    padding-bottom: 1px;
    background-color: var(--pc-inset);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--pc-stone-dim);
    border-top-color: var(--pc-stone-dim);
    border-right-color: var(--pc-stone-dim);
    border-bottom-color: var(--pc-stone-dim);
    font-size: var(--pc-fs-1);
}

.pc-chip-swatch {
    width: 6px;
    height: 6px;
    margin-right: 3px;
}

.pc-chip--burn { color: var(--pc-torch); }
.pc-chip--burn .pc-chip-swatch { background-color: var(--pc-torch); }
.pc-chip--freeze { color: var(--pc-ice); }
.pc-chip--freeze .pc-chip-swatch { background-color: var(--pc-ice); }
.pc-chip--poison { color: var(--pc-xp); }
.pc-chip--poison .pc-chip-swatch { background-color: var(--pc-xp); }

/* 아이템 슬롯 — 선택 = 골드 (탭=선택 / 재탭=실행) */
.pc-slot {
    width: 40px;
    height: 40px;
    background-color: var(--pc-inset);
    align-items: center;
    justify-content: center;
    margin: 2px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--pc-stone-dim);
    border-top-color: var(--pc-stone-dim);
    border-right-color: var(--pc-stone-dim);
    border-bottom-color: var(--pc-stone-dim);
}

.pc-slot--selected {
    border-left-color: var(--pc-gold);
    border-top-color: var(--pc-gold);
    border-right-color: var(--pc-gold);
    border-bottom-color: var(--pc-gold);
}

.pc-slot-qty {
    position: absolute;
    right: 2px;
    bottom: 1px;
    font-size: var(--pc-fs-1);
    color: var(--pc-text);
}

/* 교체 가능한 32px Torchstone UI 스프라이트를 PC HUD에서 24px로 표시한다.
   의미는 UXML의 버튼/레이블 계약이 소유하고 그림만 이 클래스로 교체한다. */
.ui-icon {
    width: 12px;
    height: 12px;
    min-width: 12px;
    min-height: 12px;
    margin-right: 2px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-button .ui-icon,
.hub-icon-button .ui-icon {
    margin-right: 0;
}

.ui-settings-icon { background-image: url("../Art/Runtime/ui-settings.png"); }
.ui-menu-icon { background-image: url("../Art/Runtime/ui-menu.png"); }
.ui-rotate-left-icon { background-image: url("../Art/Runtime/ui-rotate-left.png"); }
.ui-rotate-right-icon { background-image: url("../Art/Runtime/ui-rotate-right.png"); }
.ui-backpack-icon { background-image: url("../Art/Runtime/ui-backpack.png"); }
.ui-wait-icon { background-image: url("../Art/Runtime/ui-wait.png"); }
.ui-melee-icon { background-image: url("../Art/Runtime/ui-melee.png"); }
.ui-ranged-icon { background-image: url("../Art/Runtime/ui-ranged.png"); }
.ui-interact-icon { background-image: url("../Art/Runtime/ui-interact.png"); }

.icon-label-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.icon-label {
    color: var(--pc-text);
    font-size: inherit;
}

/* ============================================================
   9-slice 스프라이트 승격 (v1.6) — 컴포넌트 라이브러리/갤러리.
   USS엔 box-shadow/clip이 없어 단순 보더였던 프레임·글로우·눈금을
   도트 9-slice 스프라이트로 교체한다. 소스 순서상 위의 단순 보더 정의를
   오버라이드한다. 스프라이트는 build_ui_nineslice_v1.py 생성.
   ⚠ 실 렌더·슬라이스 미세조정은 Unity(DesignSystemGallery)에서 확인.
   현재 라이브 HUD는 .pc-heart 외 이 컴포넌트를 쓰지 않아 영향 없음.
   ============================================================ */

/* 창 크롬 — 깎인 모서리 도트 프레임(패널 채움 baked → 진짜 컷코너) */
.pc-window {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Art/Runtime/ui-window-frame.png");
    -unity-slice-left: 11;
    -unity-slice-top: 11;
    -unity-slice-right: 11;
    -unity-slice-bottom: 11;
    -unity-slice-scale: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.pc-window--teal {
    background-image: url("../Art/Runtime/ui-window-frame-teal.png");
}

/* 상시 HUD 플레이트 — 코너 브래킷 크롬 (v1.8)
   USS 에는 ::before/::after 가 없어 "모서리만 그리는 박스"를 의사요소로 만들 수 없다.
   9-slice 로 승격했고 **모서리 타일은 늘어나지 않으므로** 패널이 커져도 브래킷 길이가
   그대로다. 늘어나는 변 구간은 비어 있어 사각 테두리가 그려지지 않는다.
   크롬 어휘는 여전히 둘(플레이트/창)이다 — 같은 플레이트를 다르게 깎았을 뿐이다. */
.pc-plate {
    background-color: rgba(5, 7, 12, 0.78);
    background-image: url("../Art/Runtime/ui-bracket-frame.png");
    -unity-slice-left: 5;
    -unity-slice-top: 5;
    -unity-slice-right: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

/* 기술 라벨 — 라틴 대문자 + 자간 1px. 대문자는 UXML 원문이 소유한다
   (UI Toolkit 에 text-transform 이 없다). 소수점 자간은 UssTypographyTests 가 막는다. */
.pc-techlabel {
    letter-spacing: 1px;
    color: var(--pc-ui-accent);
}

/* 골드 글로우 — 현재 층 / 선택 슬롯 / 선택 액션 (한 화면 한 곳) */
.pc-dia--current,
.pc-dbtn--selected,
.pc-slot--selected {
    background-image: url("../Art/Runtime/ui-glow-frame.png");
    -unity-slice-left: 11;
    -unity-slice-top: 11;
    -unity-slice-right: 11;
    -unity-slice-bottom: 11;
    -unity-slice-scale: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

/* 게이지 세그먼트 눈금 — fill 위에 얹는 절대배치 오버레이(가로 반복) */
.pc-bar-ticks {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../Art/Runtime/ui-gauge-tick.png");
    background-repeat: repeat no-repeat;
}

/* ============================================================
   화면공간 비네트 (v1.7) — 월드만 어둡게 하고 UI는 건드리지 않는다.
   URP 포스트프로세싱을 켜지 않는 이유는 build_ui_nineslice_v1.py 의
   vignette() 주석에 있다(요약: 매끄러운 그라디언트는 도트 위에서 이물질로 읽히고,
   씬 clear color 가 이미 --pc-void 라 곱셈 비네트가 어둡게 할 것이 거의 없다).

   각 화면 루트의 **첫 자식**으로 둔다 = 모든 HUD 콘텐츠 뒤. 늘어나는 것은
   투명한 중앙뿐이라 디더 도트가 모든 패널 배율에서 크기를 유지한다.
   ============================================================ */

.pc-vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../Art/Runtime/ui-vignette.png");
    -unity-slice-left: 24;
    -unity-slice-top: 24;
    -unity-slice-right: 24;
    -unity-slice-bottom: 24;
    -unity-slice-scale: 1px;
}
