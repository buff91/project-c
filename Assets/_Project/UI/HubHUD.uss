.hub-topbar {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    flex-direction: row;
    justify-content: space-between;
}

.hub-pill {
    flex-direction: row;
    align-items: center;
    padding: 2px 6px;
}

.hub-top-actions {
    flex-direction: row;
    align-items: center;
}

.hub-caption {
    color: var(--pc-dim);
    font-size: var(--pc-fs-1);
    margin-right: 8px;
}

.hub-gold {
    color: rgb(255, 213, 84);
    font-size: var(--pc-fs-2);
}

.hub-continue {
    color: rgb(238, 244, 230);
    font-size: var(--pc-fs-1);
    display: none;
}

.hub-continue.is-available {
    display: flex;
}

.hub-icon-button {
    width: 20px;
    height: 20px;
    margin-left: 4px;
    color: var(--pc-gold);
    font-size: var(--pc-fs-1);
}

/* DesignSystem 의 .ui-icon 기본값은 24px(옛 960×540 캔버스)이고 허브엔 오버라이드가
   없었다 — "갤러리 전용"이라던 옛 기본값이 라이브 화면으로 새던 유일한 경로다. */
.hub-icon-button .ui-icon {
    width: 10px;
    height: 10px;
    min-width: 10px;
    min-height: 10px;
}

.hub-menu-actions {
    align-self: stretch;
    justify-content: center;
}

.hub-menu-actions > .settings-reset,
.hub-menu-actions > .settings-done {
    width: 80px;
}

/* 던전 메시지 로그와 같은 플레이트 어휘. 캠프도 같은 시스템으로 읽혀야 한다. */
.hub-status-zone {
    position: absolute;
    bottom: 8px;
    left: 8px;
    right: auto;
    translate: 0 0;
    align-items: flex-start;
}

/* 상시 문장이 아니다 — 컨트롤러가 켜고 7초 뒤 닫는다. */
.hub-status-zone .feedback-chip {
    display: none;
    min-height: 0;
    max-width: 264px;
    padding: 2px 4px;
    margin-top: 0;
    border-radius: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--pc-stone-dim);
    border-right-color: var(--pc-stone-dim);
    border-top-color: var(--pc-stone-dim);
    border-bottom-color: var(--pc-stone-dim);
    background-color: rgba(5, 7, 12, 0.78);
}

.hub-status-zone .feedback-chip.is-open {
    display: flex;
}

.hub-status-zone .chip-dot {
    display: none;
}

.hub-status-zone .chip-label {
    color: var(--pc-text);
    font-size: var(--pc-fs-1);
    white-space: normal;
}

.hub-dungeon-card {
    width: 528px;
    max-width: 92%;
}

.hub-dungeon-layout {
    flex-direction: row;
    margin-top: 8px;
    margin-bottom: 8px;
}

.hub-dungeon-list {
    width: 42%;
    margin-right: 8px;
}

.hub-dungeon-option {
    min-height: 32px;
    margin-bottom: 4px;
    padding: 4px 6px;
    color: var(--pc-text);
    background-color: var(--pc-btn-bg);
    border-width: 1px;
    border-color: var(--pc-stone);
    white-space: normal;
    -unity-text-align: middle-left;
}

.hub-dungeon-option.selected {
    color: var(--pc-gold);
    background-color: var(--pc-action-bg);
    border-color: var(--pc-gold-deep);
}

/* 잠금 표현은 `locked` 한 벌이다. 컨트롤러가 `is-locked` 를 토글하던 시절엔 USS 어디에도
   그 규칙이 없어 붙어도 화면이 변하지 않았다(UI_ARCHITECTURE 의 "알려진 어긋남"). */
.hub-dungeon-option.locked,
.hub-bounty-row.locked {
    color: var(--pc-dim);
    opacity: 0.55;
}

.hub-dungeon-detail {
    flex-grow: 1;
    min-height: 104px;
    padding: 8px;
    background-color: rgba(10, 12, 16, 0.72);
    border-left-width: 2px;
    border-left-color: var(--pc-gold-deep);
}

.hub-dungeon-name {
    color: var(--pc-gold);
    font-size: var(--pc-fs-2);
}

.hub-dungeon-route {
    color: var(--pc-teal);
    font-size: var(--pc-fs-1);
    margin-top: 8px;
}

.hub-dungeon-desc {
    color: var(--pc-text);
    font-size: var(--pc-fs-1);
    margin-top: 6px;
    white-space: normal;
}

.hub-dungeon-legend {
    color: var(--pc-dim);
    font-size: var(--pc-fs-1);
    margin-top: 8px;
    white-space: normal;
}

.hub-dungeon-enter {
    min-width: 120px;
}

.hub-shop-list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.hub-shop-item {
    width: 31%;
    margin: 1%;
    padding: 4px 2px;
    font-size: var(--pc-fs-1);
    background-color: rgb(34, 28, 18);
    color: rgb(233, 220, 192);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(74, 58, 34);
    white-space: normal;
}

.hub-shop-item:hover {
    background-color: rgb(50, 40, 26);
}

.hub-feedback {
    color: rgb(255, 213, 84);
    font-size: var(--pc-fs-1);
    min-height: 12px;
}

.hub-stash-detail {
    white-space: normal;
}

/* ── 상점/창고 슬롯 그리드 ───────────────────────────── */

.hub-header-right {
    flex-direction: row;
    align-items: center;
}

.hub-modal-gold {
    color: rgb(255, 213, 84);
    font-size: var(--pc-fs-2);
    margin-right: 10px;
}

.hub-shop-feedback {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.slot-price {
    color: rgb(255, 213, 84);
    font-size: var(--pc-fs-1);
}

/* 허브도 던전과 동일한 Torchstone 팔레트/모서리/강조 규칙을 사용한다. */
.hub-caption {
    color: var(--pc-dim);
    font-size: var(--pc-fs-1);
}

.hub-gold,
.hub-modal-gold,
.hub-feedback,
.slot-price {
    color: var(--pc-gold);
}

.hub-continue {
    color: var(--pc-text);
    font-size: var(--pc-fs-1);
}

.hub-shop-item {
    color: var(--pc-text);
    background-color: var(--pc-btn-bg);
    border-left-color: var(--pc-stone);
    border-top-color: var(--pc-stone);
    border-right-color: var(--pc-stone-dim);
    border-bottom-color: var(--pc-stone-dim);
    border-radius: 0;
}

.hub-shop-item:hover {
    color: var(--pc-gold);
    background-color: var(--pc-action-bg);
    border-left-color: var(--pc-gold-deep);
    border-top-color: var(--pc-gold-deep);
}

.hud-root.is-narrow .hub-topbar {
    top: 8px;
    left: 8px;
    right: 8px;
}

.hud-root.is-narrow .hub-pill {
    padding: 5px 8px;
}

.hud-root.is-narrow .hub-icon-button {
    width: 44px;
    height: 44px;
}

.hud-root.is-narrow .hub-status-zone {
    left: 8px;
    right: 8px;
    bottom: 8px;
}

.hub-icon-button {
    align-items: center;
    justify-content: center;
}

.hud-root.is-narrow .hub-status-zone .status-chip {
    max-width: 100%;
}

.hud-root.is-narrow .hub-dungeon-card {
    max-width: 94%;
}

.hud-root.is-narrow .hub-dungeon-layout {
    flex-direction: column;
}

.hud-root.is-narrow .hub-dungeon-list {
    width: 100%;
    margin-right: 0;
    flex-direction: row;
}

.hud-root.is-narrow .hub-dungeon-option {
    flex-grow: 1;
    width: 31%;
    min-height: 58px;
    margin-right: 4px;
    padding: 6px;
    font-size: var(--pc-fs-1);
    -unity-text-align: middle-center;
}

.hud-root.is-narrow .hub-dungeon-detail {
    min-height: 148px;
    margin-top: 8px;
    padding: 12px;
}

/* ── 출정 준비: 창고 ↔ 멀티슬롯 백팩 ─────────────────── */

.expedition-card,
.hud-root.is-expanded .expedition-card,
.hud-root.is-landscape .expedition-card {
    width: 600px;
    max-width: 96%;
    /* 높이는 내용이 정하고 뷰포트가 상한을 준다. 88% 로 못박으면 창고가 비었을 때도
       카드가 화면을 채우며 페인이 늘어나고 하단 안내가 카드 밖으로 잘린다
       (인벤토리 카드에서 배운 것과 같다). */
    height: auto;
    max-height: 100%;
}

.expedition-layout {
    width: 100%;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
}

.expedition-card .unity-scroll-view__horizontal-scroller {
    display: none;
}

.expedition-card .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.expedition-pane {
    padding: 6px;
    background-color: rgb(8, 10, 14);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--pc-stone-dim);
    border-top-color: var(--pc-stone-dim);
    border-right-color: rgb(30, 27, 25);
    border-bottom-color: rgb(30, 27, 25);
}

.expedition-stash-pane {
    width: 272px;
}

.expedition-loadout-pane {
    width: 256px;
    min-height: 148px;
}

.expedition-transfer-rail {
    width: 48px;
    min-height: 96px;
    align-items: center;
    justify-content: center;
}

.expedition-transfer-symbol {
    color: var(--pc-gold);
    font-size: var(--pc-fs-2);
}

.expedition-transfer-hint,
.expedition-hero-label,
.expedition-locked-hint {
    color: var(--pc-dim);
    font-size: var(--pc-fs-1);
    white-space: normal;
    -unity-text-align: middle-center;
}

.expedition-transfer-hint {
    margin-top: 8px;
}

.expedition-hero-label {
    margin-top: 3px;
    -unity-text-align: middle-left;
}

.expedition-locked-hint {
    width: 100%;
    margin-top: 6px;
}

.expedition-backpack-grid {
    flex-shrink: 0;
}

.hud-root.is-expanded .expedition-loadout-pane .inventory-section-header,
.hud-root.is-landscape .expedition-loadout-pane .inventory-section-header {
    width: 100%;
    height: auto;
}

.hud-root.is-expanded .expedition-loadout-pane .backpack-grid,
.hud-root.is-landscape .expedition-loadout-pane .backpack-grid {
    width: 240px;
    min-width: 240px;
}

.hud-root.is-expanded .expedition-card .unity-scroll-view__content-container,
.hud-root.is-landscape .expedition-card .unity-scroll-view__content-container {
    padding-right: 8px;
}

.expedition-detail {
    width: 100%;
    min-height: 64px;
    margin-top: 6px;
    padding: 6px;
    flex-direction: row;
    align-items: center;
}

.expedition-detail-copy {
    flex-grow: 1;
    min-width: 140px;
}

.expedition-feedback {
    margin-top: 8px;
}

.expedition-actions {
    min-width: 96px;
    margin-left: 6px;
}

.expedition-transfer-button {
    width: 96px;
    min-height: 20px;
    margin: 2px 0;
}

.backpack-item.loadout-starter {
    background-color: rgb(19, 31, 36);
    border-left-color: var(--pc-teal);
    border-top-color: var(--pc-teal);
}

.loadout-starter-badge {
    position: absolute;
    left: 2px;
    top: 2px;
    color: var(--pc-ice);
    font-size: var(--pc-fs-1);
    background-color: rgb(6, 15, 19);
}

.expedition-drag-source {
    opacity: 0.5;
}

.expedition-pane.drop-valid {
    border-left-color: var(--pc-gold);
    border-right-color: var(--pc-gold);
    border-top-color: var(--pc-gold);
    border-bottom-color: var(--pc-gold);
    background-color: rgb(28, 24, 13);
}

.expedition-pane.drop-invalid {
    border-left-color: rgb(225, 76, 66);
    border-right-color: rgb(225, 76, 66);
    border-top-color: rgb(225, 76, 66);
    border-bottom-color: rgb(225, 76, 66);
    background-color: rgb(35, 12, 14);
}

.hud-root.is-narrow .expedition-card {
    width: 94%;
    max-width: 94%;
    height: 94%;
}

.hud-root.is-narrow .expedition-layout {
    flex-direction: column;
    align-items: center;
}

.hud-root.is-narrow .expedition-stash-pane,
.hud-root.is-narrow .expedition-loadout-pane {
    width: 100%;
    max-width: 100%;
}

.hud-root.is-narrow .expedition-transfer-rail {
    width: 100%;
    min-height: 48px;
    flex-direction: row;
}

.hud-root.is-narrow .expedition-transfer-hint {
    margin: 0 0 0 8px;
}

.hud-root.is-narrow .expedition-detail {
    flex-direction: column;
    align-items: stretch;
}

.hud-root.is-narrow .expedition-detail .inventory-detail-icon {
    align-self: center;
}

.hud-root.is-narrow .expedition-actions {
    width: 100%;
    min-width: 0;
    margin: 10px 0 0 0;
    flex-direction: row;
}

.hud-root.is-narrow .expedition-transfer-button {
    width: 49%;
    margin: 0 2px;
    flex-grow: 1;
}

/* ── 대장간 / 의뢰 게시판 ─────────────────────────────── */

.hub-smith-list,
.hub-bounty-list {
    flex-direction: column;
    margin-top: 6px;
}

.hub-smith-row,
.hub-bounty-row {
    background-color: rgb(34, 28, 18);
    border-width: 1px;
    border-color: rgb(74, 58, 34);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 6px;
}

.hub-smith-row {
    flex-direction: row;
    align-items: center;
}

.hub-smith-info {
    flex-grow: 1;
    flex-shrink: 1;
}

.hub-row-title {
    color: var(--pc-text);
    font-size: var(--pc-fs-1);
}

.hub-row-desc {
    color: var(--pc-dim);
    font-size: var(--pc-fs-1);
    white-space: normal;
    margin-top: 2px;
}

.hub-smith-buy {
    min-width: 56px;
    margin-left: 6px;
}

.hub-smith-buy:disabled {
    opacity: 0.5;
}

.hub-bounty-row {
    flex-direction: column;
}

.hub-bounty-reward {
    color: var(--pc-gold);
    font-size: var(--pc-fs-1);
    margin-top: 3px;
}

/* 기록 투입 버튼. 줄 안에서 왼쪽에 붙여 진행 문구 바로 아래에 오게 한다 —
   눌렀을 때 어떤 숫자가 움직이는지가 시선 이동 없이 읽혀야 한다. */
.hub-codex-invest {
    align-self: flex-start;
    min-width: 64px;
    margin-top: 4px;
}

.hub-codex-invest:disabled {
    opacity: 0.5;
}

.hub-bounty-empty {
    color: var(--pc-dim);
    font-size: var(--pc-fs-1);
    white-space: normal;
}

/* 던전 모달과 같은 창 어휘. DesignSystem 의 .pc-window 는 화면별 USS 보다 먼저 로드돼
   같은 특정성에서 밀리므로, .settings-card 의 솔리드 패널과 보더를 여기서 걷어내야
   9-slice 프레임이 보인다(PrototypeHUD.Desktop.uss 와 같은 처리). */
.hud-root .settings-card.pc-window {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding: 12px;
}
