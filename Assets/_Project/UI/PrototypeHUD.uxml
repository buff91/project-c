<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="DisplaySettings" src="DisplaySettings.uxml" />
    <ui:Style src="DesignSystem.uss" />
    <ui:Style src="PrototypeHUD.uss" />
    <ui:VisualElement name="hud-root" class="hud-root">
        <!-- 화면공간 비네트. 첫 자식 = 모든 HUD 콘텐츠 뒤 → 월드만 어둡게 한다. -->
        <ui:VisualElement class="pc-vignette" picking-mode="Ignore" />
        <!-- A · 바이탈. 상태이상 칩은 hp 바로 아래 붙는다 — HP 를 깎는 것과 HP 그 자체는
             같은 질문("이번 턴을 버티나")이라 눈이 한 번만 움직여야 한다. -->
        <ui:VisualElement class="vitals">
            <ui:VisualElement class="hp-strip">
                <ui:VisualElement name="hp-hearts" class="hp-hearts">
                    <ui:VisualElement class="pc-heart" />
                    <ui:VisualElement class="pc-heart" />
                    <ui:VisualElement class="pc-heart" />
                    <ui:VisualElement class="pc-heart" />
                    <ui:VisualElement class="pc-heart" />
                </ui:VisualElement>
                <ui:Label name="hp-value" text="--/--" class="hp-value" />
            </ui:VisualElement>
            <!-- 활성 상태이상 칩은 컨트롤러가 hunger-label 앞에 끼워 넣는다.
                 빈 행이면 높이 0이라 평상시 비용이 없다. -->
            <ui:VisualElement name="status-chips" class="status-chips">
                <ui:Label name="hunger-label" text="포만" class="pc-chip hunger-label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- C · 계기 묶음. 층 정보와 미니맵은 하나의 우상단 계기다. -->
        <ui:VisualElement class="artifact-panel minimap-panel">
            <ui:VisualElement class="minimap-header">
                <ui:VisualElement class="minimap-header-buttons">
                    <ui:Button name="mode-button" class="settings-button hud-mode-button" tooltip="플레이 시야 / 전체 구조 디버그 전환">
                        <ui:Label name="mode-label" text="FOV" class="hud-mode-label" />
                    </ui:Button>
                    <ui:Button name="settings-button" class="settings-button icon-button" tooltip="화면 설정">
                        <ui:VisualElement class="ui-icon ui-settings-icon" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="game-menu-button" class="settings-button icon-button" tooltip="게임 메뉴 (ESC)">
                        <ui:VisualElement class="ui-icon ui-menu-icon" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="minimap-grid">
                <ui:VisualElement name="minimap-view" class="minimap-view" />
            </ui:VisualElement>
            <ui:VisualElement class="view-controls">
                <ui:Button name="rotate-left" class="rotate-button icon-button" tooltip="왼쪽 회전 (Q)">
                    <ui:VisualElement class="ui-icon ui-rotate-left-icon" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label name="view-label" text="VIEW 1/4" class="view-label" />
                <ui:Button name="rotate-right" class="rotate-button icon-button" tooltip="오른쪽 회전 (E)">
                    <ui:VisualElement class="ui-icon ui-rotate-right-icon" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <!-- PC 전용 수직 보기 레일. 공용 트리에 두되 base USS에서 숨기고 Desktop에서만 연다. -->
            <ui:VisualElement name="vertical-view-controls" class="vertical-view-controls">
                <ui:Button name="vertical-view-up" text="▲" class="vertical-view-button" tooltip="실제 개구부를 통해 윗층 보기" />
                <ui:Button name="vertical-view-current" text="◆" class="vertical-view-button" tooltip="현재 플레이 층으로 돌아오기" />
                <ui:Button name="vertical-view-down" text="▼" class="vertical-view-button" tooltip="실제 개구부를 통해 아랫층 보기" />
            </ui:VisualElement>
            <ui:Label name="vertical-view-state" text="현재 --" class="vertical-view-state" />
        </ui:VisualElement>

        <!-- D · 층 스택. "▲ B1 · ▼ B3" 텍스트 한 줄을 공간적 수직성 지표로 바꾼다 —
             기둥 ①(입체 공간)은 읽는 게 아니라 보이는 것이어야 한다.
             이름은 그대로 두고 역할만 재배정한다(계약 테스트가 이름을 단언한다):
               floor-label   → 위쪽 경로 캡(▲)
               depth-label   → 현재 층 눈금 옆의 금색 층 이름 (컨트롤러가 현재 행으로 옮긴다)
               location-label→ 높이 한 줄
               depth-caption → 데스크톱에서 숨김(진행도는 발견 카드가 말한다) -->
        <ui:VisualElement name="floor-stack" class="floor-stack" picking-mode="Ignore">
            <ui:Label name="floor-label" text="" class="floor-cap" />
            <ui:VisualElement class="floor-ticks" picking-mode="Ignore" />
            <ui:Label name="depth-label" text="B2" class="depth-value" />
            <ui:Label name="location-label" text="HEIGHT 0" class="elevation-label" />
            <ui:Label name="depth-caption" text="던전 1/3" class="micro-caption depth-caption" />
        </ui:VisualElement>

        <ui:VisualElement name="boss-panel" class="artifact-panel boss-panel" picking-mode="Ignore">
            <ui:Label name="boss-kicker" text="FINAL GUARDIAN" class="boss-kicker" />
            <ui:Label name="boss-name" text="감시자" class="boss-name" />
            <ui:VisualElement class="boss-health-track">
                <ui:VisualElement name="boss-health-fill" class="boss-health-fill" />
            </ui:VisualElement>
            <ui:Label name="boss-health-value" text="20 / 20" class="boss-health-value" />
            <ui:Label name="boss-objective" text="보스를 쓰러뜨려 출구의 봉인을 해제하라" class="boss-objective" />
        </ui:VisualElement>

        <ui:VisualElement name="vertical-route-discovery" class="artifact-panel vertical-route-discovery" picking-mode="Ignore">
            <ui:Label text="새로운 길을 발견했다" class="route-discovery-kicker" />
            <ui:Label name="route-discovery-title" text="하층 계단 · B2" class="route-discovery-title" />
            <ui:Label name="route-discovery-detail" text="어두운 계단 입구 위에서 탭하면 한 층 아래로 이동한다." class="route-discovery-detail" />
        </ui:VisualElement>

        <!-- E · 메시지 로그. SPD 계보 턴제인데 직전 턴에 무슨 일이 있었는지 볼 방법이
             없었다. 데이터는 이미 InteractionFeedback 이 쏘고 있었고 3초 뒤 버려질 뿐이었다.
             feedback-chip 은 이름을 유지한 채 "가장 최신 줄"이 되고, 지난 줄은 컨트롤러가
             그 앞에 .message-line 으로 끼워 넣는다. 플레이트는 로그 하나만 쓴다. -->
        <ui:VisualElement class="status-zone">
            <ui:VisualElement name="message-log" class="message-log">
                <ui:VisualElement name="feedback-chip" class="status-chip feedback-chip">
                    <ui:VisualElement class="chip-dot feedback-dot" />
                    <ui:Label name="status-label" text="" class="chip-label" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="vertical-hint-chip" class="status-chip route-chip">
                <ui:VisualElement class="chip-dot route-dot" />
                <ui:Label name="vertical-hint-label" text="" class="chip-label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="hud-bottom">
            <ui:VisualElement class="resources">
                <ui:Button name="potion-button" class="artifact-panel resource-pill item-button" tooltip="응급 키트 사용 — HP 회복, 행동 1회 소비">
                    <ui:VisualElement class="resource-icon potion-icon" />
                    <ui:Label name="potion-count" text="×0" class="resource-value" />
                </ui:Button>
                <ui:Button name="bomb-button" class="artifact-panel resource-pill item-button" tooltip="급조 폭발물 투척 — 누른 뒤 목표 타일 탭, 3×3 폭발+화상+넉백">
                    <ui:VisualElement class="resource-icon bomb-icon" />
                    <ui:Label name="bomb-count" text="×0" class="resource-value" />
                </ui:Button>
                <ui:Button name="frost-button" class="artifact-panel resource-pill item-button" tooltip="냉각재 수류탄 투척 — 낮은 피해 + 빙결">
                    <ui:VisualElement class="resource-icon frost-icon" />
                    <ui:Label name="frost-count" text="×0" class="resource-value" />
                </ui:Button>
                <ui:Button name="bag-button" class="artifact-panel resource-pill item-button bag-button" tooltip="백팩 열기 (I)">
                    <ui:VisualElement class="ui-icon ui-backpack-icon" picking-mode="Ignore" />
                    <ui:Label text="백팩" class="resource-value" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement class="action-cluster">
                <ui:Button name="combat-button" class="combat-button action-label-button" tooltip="근접 / 원거리 공격 전환">
                    <ui:VisualElement name="combat-icon" class="ui-icon ui-melee-icon" picking-mode="Ignore" />
                    <ui:Label name="combat-label" text="근접" class="action-button-label" />
                </ui:Button>
                <ui:Button name="wait-button" class="mode-button wait-button action-label-button" tooltip="이동 없이 한 턴을 보낸다 (X)">
                    <ui:VisualElement class="ui-icon ui-wait-icon" picking-mode="Ignore" />
                    <ui:Label text="대기  X" class="action-button-label" />
                </ui:Button>
                <ui:Button name="interact-button" class="interact-button action-label-button" tooltip="현재 문맥 행동 실행">
                    <ui:VisualElement class="ui-icon ui-interact-icon" picking-mode="Ignore" />
                    <ui:Label name="interact-label" text="상호작용" class="action-button-label" />
                </ui:Button>
                <ui:VisualElement class="artifact-panel turn-pill">
                    <ui:VisualElement class="turn-dot" />
                    <ui:Label text="내 턴" class="turn-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Instance template="DisplaySettings" class="settings-template-host" picking-mode="Ignore" />

        <ui:VisualElement name="inventory-modal" class="settings-modal">
            <ui:VisualElement class="artifact-panel pc-window settings-card inventory-card diablo-inventory-card">
                        <ui:VisualElement class="settings-header">
                    <ui:VisualElement>
                        <ui:Label text="BACKPACK" class="settings-title" />
                        <ui:Label text="아이템 크기만큼 칸 점유 · 자동 정리" class="settings-subtitle" />
                    </ui:VisualElement>
                    <ui:Button name="inventory-close" text="×" class="settings-close" tooltip="인벤토리 닫기" />
                </ui:VisualElement>
                <ui:ScrollView mode="Vertical" class="inventory-content-scroll">
                    <ui:VisualElement class="inventory-layout">
                        <ui:VisualElement class="inventory-grid-pane">
                            <ui:VisualElement class="inventory-section-header">
                                <ui:Label text="소지품" class="inventory-section-title" />
                                <ui:Label name="inventory-capacity" text="0 / 24" class="inventory-capacity" />
                            </ui:VisualElement>
                            <!-- 점유율 게이지. 숫자는 이미 위에 있었지만 "이제 곧 못 줍는다"는
                                 압박은 한눈에 안 읽혔다 — 막대가 하는 일이 그것이다.
                                 판정은 Core(BackpackPressure)가 소유한다. -->
                            <ui:VisualElement name="inventory-capacity-bar" class="pc-bar-track inventory-capacity-bar" picking-mode="Ignore">
                                <ui:VisualElement name="inventory-capacity-fill" class="pc-bar-fill inventory-capacity-fill" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="inventory-grid" class="inventory-grid item-slot-grid backpack-grid" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-detail inventory-detail-pane">
                            <ui:VisualElement name="inventory-detail-icon" class="resource-icon inventory-detail-icon is-empty" />
                            <ui:VisualElement class="inventory-detail-copy">
                                <ui:Label name="inventory-detail-name" text="빈 백팩" class="inventory-detail-name" />
                                <ui:Label name="inventory-detail-desc" text="던전에서 얻은 아이템이 이곳에 쌓입니다." class="inventory-detail-desc" />
                                <!-- 분류·크기·가치. 전부 ItemDefinition 에 이미 있는 값이다 —
                                     내구도/충전 게이지는 그런 시스템이 아직 없어 넣지 않았다. -->
                                <ui:VisualElement name="inventory-detail-stats" class="inventory-detail-stats" />
                            </ui:VisualElement>
                            <!-- 골드 슬래브(.settings-done)를 뺀다. "화면당 골드 글로우 하나" 규칙에서
                                 인벤토리의 골드는 선택 슬롯 테두리가 이미 쓰고 있다. -->
                            <ui:Button name="inventory-use" text="사용" class="pc-btn pc-btn--action inventory-detail-action" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="craft-section">
                        <ui:Label text="현장 조합 · 행동 1회" class="craft-caption" />
                        <ui:VisualElement name="craft-list" class="craft-list" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="action-wheel" class="action-wheel" />

        <ui:VisualElement name="game-menu-modal" class="settings-modal">
            <ui:VisualElement class="artifact-panel pc-window settings-card gameover-card">
                <ui:Label text="게임 메뉴" class="gameover-title" />
                <ui:Label text="포기하면 소지품을 모두 잃는다 (창고는 유지)" class="gameover-detail" />
                <ui:VisualElement class="settings-actions game-menu-actions">
                    <ui:Button name="menu-abandon" text="게임 포기하기" class="settings-reset" />
                    <ui:Button name="menu-lobby" text="로비로 가기" class="settings-reset" />
                    <ui:Button name="menu-resume" text="계속하기" class="settings-done" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="exit-modal" class="settings-modal">
            <ui:VisualElement class="artifact-panel pc-window settings-card gameover-card">
                <ui:Label name="exit-title" text="던전 출구" class="gameover-title" />
                <ui:Label name="exit-desc" text="" class="gameover-detail" />
                <ui:Label text="죽으면 전부 잃는다 — 생환만이 전리품을 지킨다" class="gameover-detail" />
                <ui:VisualElement class="settings-actions">
                    <ui:Button name="exit-extract" text="생환하기" class="settings-reset" />
                    <ui:Button name="exit-advance" text="더 나아가기" class="settings-done" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="debug-panel" class="debug-panel">
            <ui:Label text="DEBUG (Ctrl+D / F1)" class="debug-title" />
            <ui:Label name="debug-status" text="--" class="debug-status" />
            <ui:VisualElement name="debug-commands" class="debug-commands" />
            <ui:ScrollView name="debug-log" class="debug-log" />
        </ui:VisualElement>

        <ui:VisualElement name="gameover-overlay" class="settings-modal gameover-overlay">
            <ui:VisualElement class="artifact-panel pc-window settings-card gameover-card">
                <ui:Label name="gameover-title" text="당신은 죽었습니다" class="gameover-title" />
                <ui:Label name="gameover-cause" text="사인: --" class="gameover-detail" />
                <ui:Label name="gameover-floor" text="도달 층: --" class="gameover-detail" />
                <ui:Label name="gameover-kills" text="처치: 0" class="gameover-detail" />
                <ui:VisualElement class="settings-actions">
                    <ui:Button name="menu-button" text="캠프로 돌아가기" class="settings-done" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
