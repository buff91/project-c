/* Pointer-first shell.
   PC 기준은 4px spacing grid / 32px persistent controls / 18px action icons.
   상시 HUD는 월드를 가리는 독립 창이 아니라 화면 가장자리의 얇은 두 레일로 묶는다. */

.hud-layout-shell {
    flex-grow: 1;
}

.hud-root.hud-desktop {
    padding: 12px;
}

/* ── Upper rail ─────────────────────────────────────────── */

.hud-root.hud-desktop .vitals {
    left: 12px;
    top: 12px;
}

.hud-root.hud-desktop .pc-heart {
    width: 20px;
    height: 18px;
    margin-right: 3px;
}

.hud-root.hud-desktop .hp-value {
    margin-left: 3px;
}

/* 층 정보는 미니맵 왼쪽에 붙는 보조 계기다. 별도 좌측 창으로 흩어놓지 않는다. */
.hud-root.hud-desktop .depth-panel {
    left: auto;
    right: 204px;
    top: 12px;
    width: 106px;
    height: 106px;
    padding: 6px 8px;
    align-items: flex-start;
    justify-content: center;
}

.hud-root.hud-desktop .depth-value,
.hud-root.hud-desktop .elevation-label,
.hud-root.hud-desktop .floor-label {
    -unity-text-align: middle-left;
}

.hud-root.hud-desktop .depth-value {
    font-size: var(--pc-fs-2);
}

.hud-root.hud-desktop .elevation-label {
    font-size: var(--pc-fs-1);
    margin-top: 4px;
}

.hud-root.hud-desktop .floor-label {
    font-size: var(--pc-fs-1);
    margin-top: 3px;
}

.hud-root.hud-desktop .minimap-panel {
    right: 12px;
    top: 12px;
    width: 184px;
    padding: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.hud-root.hud-desktop .minimap-header {
    height: 20px;
}

.hud-root.hud-desktop .minimap-header-buttons > .settings-button {
    width: 26px;
    min-width: 26px;
    height: 20px;
}

.hud-root.hud-desktop .minimap-header-buttons > .hud-mode-button {
    width: 34px;
    min-width: 34px;
}

.hud-root.hud-desktop .minimap-grid {
    height: 44px;
    margin-top: 4px;
}

.hud-root.hud-desktop .view-controls {
    height: 24px;
    margin-top: 4px;
}

.hud-root.hud-desktop .rotate-button.icon-button {
    width: 32px;
    min-width: 32px;
    height: 24px;
}

.hud-root.hud-desktop .icon-button .ui-icon,
.hud-root.hud-desktop .rotate-button .ui-icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
}

/* ── Transient information ──────────────────────────────── */

.hud-root.hud-desktop .status-zone {
    left: 12px;
    bottom: 52px;
    translate: 0 0;
    align-items: flex-start;
}

.hud-root.hud-desktop .status-chip {
    min-height: 20px;
    max-width: 280px;
    padding: 3px 7px;
    margin-top: 3px;
}

.hud-root.hud-desktop .feedback-chip,
.hud-root.hud-desktop .route-chip {
    border-left-width: 2px;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(8, 12, 16, 0.88);
}

.hud-root.hud-desktop .feedback-chip {
    border-left-color: var(--pc-gold);
}

.hud-root.hud-desktop .route-chip {
    border-left-color: var(--pc-teal);
}

.hud-root.hud-desktop .feedback-chip .chip-label {
    color: var(--pc-gold);
}

.hud-root.hud-desktop .route-chip .chip-label {
    color: var(--pc-ice);
}

.hud-root.hud-desktop .chip-dot {
    display: none;
}

/* ── Bottom quick/action rails ───────────────────────────── */

.hud-root.hud-desktop .hud-bottom {
    left: 12px;
    right: 12px;
    bottom: 12px;
    height: 32px;
    align-items: stretch;
}

.hud-root.hud-desktop .resources,
.hud-root.hud-desktop .action-cluster {
    height: 32px;
    flex-wrap: nowrap;
    align-items: stretch;
    background-color: rgba(8, 12, 16, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--pc-stone-dim);
    border-top-color: var(--pc-stone);
    border-right-color: rgb(35, 31, 28);
    border-bottom-color: rgb(35, 31, 28);
}

.hud-root.hud-desktop .resources {
    flex-shrink: 0;
}

.hud-root.hud-desktop .resource-pill {
    height: 30px;
    min-width: 78px;
    margin: 0;
    padding: 4px 7px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 1px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-color: var(--pc-stone-dim);
}

.hud-root.hud-desktop .resource-icon,
.hud-root.hud-desktop .bag-button .ui-icon {
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    margin-right: 5px;
}

.hud-root.hud-desktop .resource-value {
    font-size: var(--pc-fs-1);
}

.hud-root.hud-desktop .bag-button {
    min-width: 68px;
}

.hud-root.hud-desktop .action-cluster {
    max-width: none;
    flex-shrink: 0;
}

.hud-root.hud-desktop .action-cluster > .mode-button,
.hud-root.hud-desktop .action-cluster > .combat-button,
.hud-root.hud-desktop .action-cluster > .interact-button {
    height: 30px;
    margin: 0;
    padding-left: 7px;
    padding-right: 7px;
    border-left-width: 0;
    border-right-width: 1px;
    border-top-width: 0;
    border-bottom-width: 0;
}

.hud-root.hud-desktop .action-cluster .ui-icon {
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    margin-right: 5px;
}

.hud-root.hud-desktop .combat-button {
    width: 96px;
}

.hud-root.hud-desktop .wait-button {
    width: 74px;
}

.hud-root.hud-desktop .interact-button {
    min-width: 96px;
    max-width: 144px;
}

.hud-root.hud-desktop .turn-pill {
    height: 30px;
    min-width: 56px;
    padding: 5px 8px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

/* 턴은 해독이 필요한 아이콘 대신 짧은 텍스트 상태로 유지한다. */
.hud-root.hud-desktop .turn-dot {
    display: none;
}

.hud-root.hud-desktop .turn-label {
    font-size: var(--pc-fs-1);
}

/* ── World action wheel ──────────────────────────────────── */

.hud-root.hud-desktop .wheel-button {
    width: 64px;
    height: 56px;
    min-width: 64px;
    min-height: 56px;
    margin-left: -32px;
    margin-top: -28px;
    padding: 5px 6px 4px 6px;
}

.hud-root.hud-desktop .wheel-button-icon {
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
}

.hud-root.hud-desktop .wheel-button-label {
    width: 52px;
    height: 16px;
}

/* ── Blocking windows ───────────────────────────────────── */

.hud-root.hud-desktop .settings-card {
    width: 560px;
}

.hud-root.hud-desktop .inventory-card {
    width: 680px;
}

.hud-root.hud-desktop .gameover-card {
    width: 520px;
}

/* 5:4, 4:3 and similarly roomy desktop windows only widen blocking windows.
   Persistent HUD density stays fixed so controls do not grow with empty space. */
.hud-root.hud-desktop.is-expanded .settings-card {
    width: 600px;
}

.hud-root.hud-desktop.is-expanded .inventory-card {
    width: 720px;
}

/* Ultrawide adds outer breathing room without scaling individual controls. */
.hud-root.hud-desktop.is-ultrawide .vitals,
.hud-root.hud-desktop.is-ultrawide .status-zone {
    left: 24px;
}

.hud-root.hud-desktop.is-ultrawide .minimap-panel {
    right: 24px;
}

.hud-root.hud-desktop.is-ultrawide .depth-panel {
    right: 216px;
}

.hud-root.hud-desktop.is-ultrawide .hud-bottom {
    left: 24px;
    right: 24px;
}
